{
  "name": "@triptogether/collab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@hocuspocus/server": "4.8.0",
    "@triptogether/db": "workspace:*",
    "@triptogether/doc": "workspace:*",
    "jsonwebtoken": "^9.0.2",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@triptogether/config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
