{
  "name": "triptogether",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @triptogether/db generate",
    "db:migrate": "pnpm --filter @triptogether/db migrate",
    "db:seed": "pnpm --filter @triptogether/db seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
