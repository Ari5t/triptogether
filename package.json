{
  "name": "triptogether",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @triptogether/db generate",
    "db:migrate": "pnpm --filter @triptogether/db migrate",
    "db:seed": "pnpm --filter @triptogether/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
