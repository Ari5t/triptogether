{
  "name": "@triptogether/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "prisma db seed",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@triptogether/config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^16.4.0",
    "prisma": "7.10.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
